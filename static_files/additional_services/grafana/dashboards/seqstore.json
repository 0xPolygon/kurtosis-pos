{
  "uid": "kurtosis-pos-seqstore",
  "title": "Sequencer & Sequence Store",
  "description": "Single pane of glass for watching block production against the in-enclave sequence store: producer publish state, seal-gate verdicts, barrier/reconcile activity, and store (ingress/gateway/auditor) health.",
  "tags": [
    "kurtosis-pos",
    "seqstore",
    "bor"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "producer",
        "label": "Producer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(sequencer_publish_state, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "seqstore dashboards",
      "tags": [
        "seqstore"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
