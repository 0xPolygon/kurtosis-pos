    {
      "type": "timeseries",
      "title": "L2 block interval",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(panoptichain_rpc_block_interval_sum{network=\"L2\"}[2m])) / sum(rate(panoptichain_rpc_block_interval_count{network=\"L2\"}[2m]))",
          "legendFormat": "avg (2m)",
          "datasource": {
            "type": "prometheus",
