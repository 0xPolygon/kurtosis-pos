                  "color": "text",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "sequencer/publish/state per producing bor node: Live, Degraded (store unreachable), Resyncing (store holds records we don't cover), Failed, Contending (losing head races)."
